{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableAllHooks": false,
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(.env*)",
      "Read(!.env*.example)",
      "Edit(.env*)",
      "Edit(!.env*.example)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(**/credentials/**)",
      "Edit(**/credentials/**)",
      "Read(**/core.env)",
      "Edit(**/core.env)",
      "Read(*.secret)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.pem)",
      "Edit(*.pem)",
      "Read(*.key)",
      "Edit(*.key)",
      "Read(/.claude/launch.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__create_deployment",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__request_promote",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__request_rollback",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__create_project_env",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__edit_project_env",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__get_project_env",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__filter_project_envs",
      "mcp__72d3659d-903c-4430-8524-74c65b254d66__get_shared_env_var",
      "mcp__ccd_session_mgmt__set_session_permission_mode",
      "mcp__ccd_host__clean_up_worktrees",
      "mcp__ccd_host__discard_kept_worktree",
      "mcp__ccd_pr__set_auto_merge"
    ],
    "ask": [
      "Bash(git push)",
      "PowerShell(git push)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(ssh *)",
      "PowerShell(ssh *)",
      "Bash(scp *)",
      "PowerShell(scp *)",
      "Bash(sftp *)",
      "PowerShell(sftp *)",
      "Bash(rsync *)",
      "PowerShell(rsync *)",
      "Bash(docker -H *)",
      "PowerShell(docker -H *)",
      "Bash(docker --context *)",
      "PowerShell(docker --context *)",
      "Bash(alembic upgrade *)",
      "PowerShell(alembic upgrade *)",
      "Bash(alembic downgrade *)",
      "PowerShell(alembic downgrade *)",
      "Bash(alembic stamp *)",
      "PowerShell(alembic stamp *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh workflow run *)",
      "PowerShell(gh workflow run *)",
      "Bash(vercel *)",
      "PowerShell(vercel *)",
      "Bash(npx vercel *)",
      "PowerShell(npx vercel *)",
      "Bash(tailscale *)",
      "PowerShell(tailscale *)",
      "Bash(cloudflared *)",
      "PowerShell(cloudflared *)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/rules/**)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git add *)",
      "Bash(git restore --staged *)",
      "Bash(git switch -c *)",
      "Bash(npx tsc --noEmit)",
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(python -m ruff check)",
      "Bash(python -m ruff check *)",
      "Bash(python -m ruff format --check *)",
      "Bash(python -m ruff format --diff *)",
      "Bash(node --test .claude/hooks/test/*.test.mjs)",
      "Bash(npm run typecheck)",
      "Bash(npm run -s typecheck)",
      "Bash(npm run build)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git show)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(git branch *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files)",
      "PowerShell(git ls-files *)",
      "PowerShell(git ls-remote *)",
      "PowerShell(git worktree list)",
      "PowerShell(git worktree list *)",
      "PowerShell(git add *)",
      "PowerShell(git restore --staged *)",
      "PowerShell(git switch -c *)",
      "PowerShell(npx tsc --noEmit)",
      "PowerShell(python -m pytest)",
      "PowerShell(python -m pytest *)",
      "PowerShell(python -m ruff check)",
      "PowerShell(python -m ruff check *)",
      "PowerShell(python -m ruff format --check *)",
      "PowerShell(python -m ruff format --diff *)",
      "PowerShell(node --test .claude/hooks/test/*.test.mjs)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run -s typecheck)",
      "PowerShell(npm run build)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/config-guard.mjs"
            ],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
