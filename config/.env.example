# ─────────────────────────────────────────────
# Evolution API v2 — Variables de entorno
# Copiar a config/.env y completar los valores
# NUNCA commitear config/.env al repo
# ─────────────────────────────────────────────

# Evolution API
EVOLUTION_API_KEY=change_this_to_a_secure_key

# Puerto expuesto en el host
EVOLUTION_PORT=8080

# Nivel de log: error | warn | info | debug | verbose
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=evolution
POSTGRES_USER=evolution_user
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql://evolution_user:change_this_postgres_password@postgres:5432/evolution?schema=public

# Redis
REDIS_PASSWORD=change_this_redis_password
REDIS_URI=redis://:change_this_redis_password@redis:6379

# Gateway (FastAPI)
GATEWAY_API_KEY=change_this_gateway_key
GATEWAY_PORT=9000
BOTLY_SHARED_NETWORK=botly-shared
# Gateway -> Botly fallback for Docker only; never configure it in Meta.
BOT_WEBHOOK_URL=http://botly-api:8000/api/v1/webhook/inbound
PUBLIC_APP_URL=http://localhost:9000
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_USERS=tomigarbe2003@gmail.com
AUTH_SESSION_TTL_SECONDS=28800
# Usuarios del Gateway: no hay registro público. Se crea una única cuenta admin
# al primer arranque; guardá esta contraseña en un gestor de secretos.
GATEWAY_USERS_DATABASE_URL=postgresql://evolution_user:change_this_postgres_password@postgres:5432/evolution
INITIAL_ADMIN_EMAIL=admin@botly.com.ar
INITIAL_ADMIN_PASSWORD=change_this_to_a_unique_12_char_password
INITIAL_ADMIN_NAME=Botly Administrator
# Cuenta técnica para la revisión de Meta. Se crea al iniciar si todavía no existe.
META_REVIEW_EMAIL=meta-review@botly.com.ar
META_REVIEW_PASSWORD=change_this_to_a_different_unique_12_char_password
META_REVIEW_NAME=Meta Review

# Origenes permitidos para el frontend que consume el gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
CORS_DEBUG=false

# Feature Flags de exposicion publica.
FEATURE_PROVIDER_EVOLUTION=true
FEATURE_PROVIDER_BAILEYS=true
FEATURE_WHATSAPP_WEB=true
FEATURE_QR_LOGIN=true
FEATURE_INSTAGRAM=true
FEATURE_WHATSAPP_CLOUD=true

# Metadata operativa por conexion: lifecycle, coexistence y senales no secretas.
CONNECTION_METADATA_PATH=/tmp/botly_connection_metadata.json
# Metadata de credenciales oficiales. No guarda access tokens en texto plano.
OFFICIAL_CREDENTIALS_PATH=/tmp/botly_official_credentials.json

# Estado operativo persistente. Docker los redirige a /var/lib/botly dentro
# del volumen gateway_data; en despliegues sin Docker usar una ruta durable.
WEBHOOK_EVENTS_PATH=/tmp/botly_webhook_events.json
ALERTS_PATH=/tmp/botly_alerts.json
AUTH_SESSIONS_PATH=/tmp/botly_gateway_sessions.json
AUTOMATIONS_PATH=/tmp/botly_automations.json
OPERATIONS_PATH=/tmp/botly_operations.json
AUTOMATION_SCHEDULER_ENABLED=true
OPERATIONS_WORKER_ENABLED=true
OPERATIONS_TARGET_CONCURRENCY=8

# Edad maxima aceptable para eventos entrantes de Evolution.
# 0 = deshabilitado. Recomendado para produccion: 600 (10 minutos).
MAX_EVENT_AGE_SECONDS=600

# Mensajes de grupos de WhatsApp. false = auditar e ignorar sin reenviar al bot.
ENABLE_GROUP_MESSAGES=false

# Webhooks globales (opcional)
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_ENABLED=false

# Meta Embedded Signup
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v23.0
META_SIGNUP_TIMEOUT_SECONDS=30
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_REQUIRE_SIGNATURE=true

# Evolution: canal WhatsApp Cloud
WA_BUSINESS_TOKEN_WEBHOOK=
WA_BUSINESS_LANGUAGE=es
