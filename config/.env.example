# ─────────────────────────────────────────────
# Evolution API v2 — Variables de entorno
# Copiar a config/.env y completar los valores
# NUNCA commitear config/.env al repo
# ─────────────────────────────────────────────

# Evolution API
EVOLUTION_API_KEY=change_this_to_a_secure_key
# Secret forwarded by Evolution to Gateway in x-evolution-webhook-secret.
# Use a different high-entropy value from EVOLUTION_API_KEY.
EVOLUTION_WEBHOOK_SECRET=change_this_to_a_different_secure_webhook_secret
# Docker-internal URL Evolution uses for its callback. The default service is
# gateway; override this if the production Compose service has another name.
EVOLUTION_WEBHOOK_URL=http://gateway:9000/webhooks/evolution

# Puerto expuesto en el host
EVOLUTION_PORT=8080

# Nivel de log: error | warn | info | debug | verbose
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=evolution
POSTGRES_USER=evolution_user
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change_this_postgres_password
DATABASE_URL=postgresql://evolution_user:change_this_postgres_password@postgres:5432/evolution?schema=public

# Redis
REDIS_PASSWORD=change_this_redis_password
REDIS_URI=redis://:change_this_redis_password@redis:6379

# Gateway (FastAPI)
GATEWAY_API_KEY=change_this_gateway_key
GATEWAY_PORT=9000
BOTLY_SHARED_NETWORK=botly-shared
# Gateway -> Botly fallback for Docker only; never configure it in Meta.
BOT_WEBHOOK_URL=http://botly-api:8000/api/v1/webhook/inbound
PUBLIC_APP_URL=http://localhost:9000
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_USERS=tomigarbe2003@gmail.com
AUTH_SESSION_TTL_SECONDS=28800
# Usuarios del Gateway: no hay registro público. Se crea una única cuenta admin
# al primer arranque; guardá esta contraseña en un gestor de secretos.
GATEWAY_USERS_DATABASE_URL=postgresql://evolution_user:change_this_postgres_password@postgres:5432/evolution
INITIAL_ADMIN_EMAIL=admin@botly.com.ar
INITIAL_ADMIN_PASSWORD=change_this_to_a_unique_12_char_password
INITIAL_ADMIN_NAME=Botly Administrator
# Cuenta técnica para la revisión de Meta. Se crea al iniciar si todavía no existe.
META_REVIEW_EMAIL=meta-review@botly.com.ar
META_REVIEW_PASSWORD=change_this_to_a_different_unique_12_char_password
META_REVIEW_NAME=Meta Review

# Origenes permitidos para el frontend que consume el gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
CORS_DEBUG=false

# Feature Flags de exposicion publica.
FEATURE_PROVIDER_EVOLUTION=true
FEATURE_PROVIDER_BAILEYS=true
FEATURE_WHATSAPP_WEB=true
FEATURE_QR_LOGIN=true
FEATURE_INSTAGRAM=true
FEATURE_WHATSAPP_CLOUD=true
ENVIRONMENT=development

# Metadata operativa por conexion: lifecycle, coexistence y senales no secretas.
CONNECTION_METADATA_PATH=/tmp/botly_connection_metadata.json
# Ownership registry de clientes/conexiones. Docker lo persiste dentro de
# gateway_data; fuera de Docker elegi una ruta durable y con permisos privados.
CONNECTION_REGISTRY_PATH=/var/lib/botly/connections/connection_registry.json
# Maximum lifetime of an unfinished Connection Setup. Expired setups stay in
# the registry for diagnosis/compensation and are not deleted automatically.
CONNECTION_SETUP_TTL_SECONDS=3600
# Periodic, bounded compensation for expired/pending setups. Only resources
# with explicit ownership proof are removed automatically.
CONNECTION_SETUP_CLEANUP_INTERVAL_SECONDS=60
# Clave dedicada opcional para cifrar secrets de webhooks. Si se omite, el
# Gateway usa GATEWAY_API_KEY como compatibilidad durante la transición.
# Use a stable, high-entropy value in production. Do not rotate or remove it
# while encrypted webhook secrets exist: startup will fail without rewriting
# them. Keep it in the production secret manager, never in Git or logs.
INSTANCE_WEBHOOKS_ENCRYPTION_KEY=
# Delivery evidence is stored independently from instance_webhooks.json.
WEBHOOK_DELIVERIES_PATH=/var/lib/botly/webhooks/deliveries.json
WEBHOOK_DELIVERY_RETENTION=250
WEBHOOK_DELIVERY_MAX_PAYLOAD_BYTES=16384
# The first migration retains instance_webhooks.json.pre-encryption-backup
# with mode 0600. It may contain plaintext: remove it manually only after a
# verified deploy and after confirming a separate secure backup exists.
# Metadata de credenciales oficiales. No guarda access tokens en texto plano.
OFFICIAL_CREDENTIALS_PATH=/tmp/botly_official_credentials.json
# Required in production before Instagram OAuth can persist credentials.
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=
INSTAGRAM_OAUTH_STATE_PATH=/var/lib/botly/oauth/instagram_states.json
# Gateway -> Botly Core canonical inbound delivery. The API key is configured
# per Instagram Connection via the protected Gateway endpoint, never here.
CORE_INBOUND_URL=http://botly-api:8000/api/v1/webhook/inbound
# Core control-plane base URL, e.g. http://botly-api:8000/api/v1/control-plane/gateway.
# The API key is a deployment-only Gateway -> Core service secret; do not commit a value.
CORE_CONTROL_PLANE_URL=
GATEWAY_CONTROL_PLANE_API_KEY=
CORE_CONTROL_PLANE_TIMEOUT_SECONDS=10
CORE_CHANNEL_CREDENTIALS_PATH=/var/lib/botly/core/core_channel_credentials.json
# Required in production before binding a Core Channel API key.
CORE_CHANNEL_CREDENTIALS_ENCRYPTION_KEY=
CORE_INBOUND_DELIVERIES_PATH=/var/lib/botly/core/inbound_deliveries.json
CORE_INBOUND_DELIVERY_MAX_ATTEMPTS=5
CORE_INBOUND_DELIVERY_BACKOFF_BASE_SECONDS=5
CORE_INBOUND_DELIVERY_POLL_SECONDS=2
CORE_INBOUND_DELIVERY_BATCH_SIZE=25
CORE_INBOUND_DELIVERY_LEASE_SECONDS=60
CORE_INBOUND_DISPATCHER_ENABLED=true

# Estado operativo persistente. Docker los redirige a /var/lib/botly dentro
# del volumen gateway_data; en despliegues sin Docker usar una ruta durable.
WEBHOOK_EVENTS_PATH=/tmp/botly_webhook_events.json
ALERTS_PATH=/tmp/botly_alerts.json
AUTH_SESSIONS_PATH=/tmp/botly_gateway_sessions.json
AUTOMATIONS_PATH=/tmp/botly_automations.json
OPERATIONS_PATH=/tmp/botly_operations.json
AUTOMATION_SCHEDULER_ENABLED=true
OPERATIONS_WORKER_ENABLED=true
OPERATIONS_TARGET_CONCURRENCY=8

# Edad maxima aceptable para eventos entrantes de Evolution.
# 0 = deshabilitado. Recomendado para produccion: 600 (10 minutos).
MAX_EVENT_AGE_SECONDS=600

# Mensajes de grupos de WhatsApp. false = auditar e ignorar sin reenviar al bot.
ENABLE_GROUP_MESSAGES=false

# Webhooks globales (opcional)
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_ENABLED=false

# Meta Embedded Signup
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v23.0
META_SIGNUP_TIMEOUT_SECONDS=30
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_REQUIRE_SIGNATURE=true
# Instagram Business Login / OAuth. This app ID is separate from META_APP_ID.
# Configure the Instagram app registered for Instagram Login; it is not a secret.
INSTAGRAM_APP_ID=1787511689049505
# Must match the callback configured for the Instagram app.
META_REDIRECT_URI=
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_API_URL=https://graph.instagram.com

# Evolution: canal WhatsApp Cloud
WA_BUSINESS_TOKEN_WEBHOOK=
WA_BUSINESS_LANGUAGE=es
